# Agent tooling. Spec Kit warned this may hold credentials, so keep it out of git.
.claude/

# Bookkeeping folder from the unrelated "specclaw" plugin (chan4lk/specclaw),
# enabled globally in Claude Code. Not part of this project's GitHub Speckit
# scaffold (.specify/, specs/) — ignored so it never gets committed by accident.
.specclaw/

# Dependencies
node_modules/

# Next.js build output
.next/
out/
build/
next-env.d.ts

# Database (SQLite). Created by Prisma at runtime, not source.
*.db
*.db-journal

# Environment and secrets. Never commit these.
.env
.env*

# Generated Prisma client. Regenerated by "prisma generate".
**/generated/prisma/

# Test coverage and TypeScript build cache
coverage/
*.tsbuildinfo

# OS and editor junk
.DS_Store
Thumbs.db

# Keep the template committed; real .env files stay ignored above.
!.env.example
